<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="jfmt-pos-rol.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">
                this.pos.get_cashier()._is_cajero ||
                this.pos.get_cashier()._is_supervisor ||
                this.pos.get_cashier()._is_admin
            </attribute>
        </xpath>
    </t>
</templates>
