<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="jfmt-pos-rol.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('orderline')]/div/div[hasclass('d-flex justify-content-between')]" position="before" >
            <span t-if="line.category_name" class="d-inline-block flex-grow-1 fw-bolder pe-1 text-truncate text-center" t-esc="line.category_name"/>
        </xpath>
    </t>
</templates>
