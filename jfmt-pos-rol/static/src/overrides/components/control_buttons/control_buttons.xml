<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="jfmt-pos-rol.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[@t-on-click='() => this.clickRefund()']" position="attributes">
            <attribute name="t-if">
                this.pos.get_cashier()._is_supervisor ||
                this.pos.get_cashier()._is_admin
            </attribute>
        </xpath>
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[@t-on-click='() => this.pos.onDeleteOrder(this.pos.get_order())']" position="attributes">
            <attribute name="t-if">
                this.pos.get_cashier()._is_supervisor ||
                this.pos.get_cashier()._is_admin
            </attribute>
        </xpath>
    </t>
</templates>
